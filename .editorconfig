root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{c,h,S}]
indent_size = 4
max_line_length = 100

[*.inc]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 8

[*.{rs,py}]
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_size = 4
