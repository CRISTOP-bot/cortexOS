# CortexOS configuration model.
# This is the planned configuration boundary; Makefile remains authoritative
# until a Kconfig frontend is implemented and tested.

mainmenu "CortexOS kernel configuration"

config ARCH_X86_64
    bool "x86_64 architecture"
    default y
    help
      Enable the primary GRUB Multiboot and QEMU boot path.

config VIRTIO_PCI
    bool "legacy VirtIO PCI discovery"
    default y
    help
      Scan conventional PCI configuration space for legacy VirtIO devices.

config DEBUG_SERIAL
    bool "serial boot diagnostics"
    default y
    help
      Keep early boot messages available through the serial console.
