#!/usr/bin/env python3
import os
import re
import subprocess
import sys

INSTALLER_DIR = os.path.dirname(os.path.abspath(__file__))
TOOLS_DIR = os.path.dirname(INSTALLER_DIR)
sys.path.insert(0, TOOLS_DIR)

from installer.config import CortexOSConfig, PartitionConfig, UserConfig
from installer.disk import detect_disks, format_size, is_efi
from installer.install import HOSTNAME_RE, USERNAME_RE, install
from installer.ui import banner, section, info, ok, warn, error, dim, confirm, prompt, password, menu

DIR = os.path.dirname(os.path.abspath(__file__))
# The launcher lives with the installer package: tools/installer/.
# Two levels up is the repository root (or / when running from the ISO).
PROJECT = os.path.dirname(os.path.dirname(DIR))


def disk_type(d):
    t = ["SSD", "HDD"][d.rotational]
    return f"{t}/NVMe" if "nvme" in d.path else t


def pick_disk() -> str | None:
    section("Disco de destino")
    disks = detect_disks()
    if not disks:
        error("No se detectaron discos (¿root?)")
        return None

    opts = []
    for d in disks:
        parts = ", ".join(f"{p.path} ({format_size(p.size)})" for p in d.partitions[:4])
        if len(d.partitions) > 4:
            parts += f", ... +{len(d.partitions)-4}"
        opts.append((f"{d.path}  {disk_type(d)}  {format_size(d.size)}", parts or "Sin particiones"))

    i = menu("Selecciona disco", opts)
    return disks[i].path if i >= 0 else None


def pick_scheme() -> tuple[bool, bool] | None:
    section("Particionado")
    opts = [
        ("Automático (todo el disco)", "Borra todo y crea particiones"),
        ("Usar existentes", "Conserva las particiones y selecciona root + boot/EFI"),
    ]
    i = menu("Modo de particionado", opts)
    if i < 0:
        return None
    uefi = is_efi()
    info("Sistema " + ("UEFI" if uefi else "BIOS") + " detectado")
    return i == 0, uefi


def pick_fs() -> str:
    section("Sistema de archivos")
    info("El kernel actual de CortexOS implementa ext2 para el almacenamiento del sistema")
    return "ext2"


def ask_hostname() -> str:
    while True:
        hostname = prompt("Hostname", default="cortexos")
        if HOSTNAME_RE.fullmatch(hostname):
            return hostname
        warn("Hostname inválido: usa letras, números, puntos y guiones")


def ask_users() -> tuple[str, list[UserConfig]]:
    section("Usuarios")
    while True:
        rp = password("Contraseña root:")
        if not rp:
            warn("No puede estar vacía")
            continue
        if any(c in rp for c in ":\n\r"):
            warn("No puede contener ':' ni saltos de línea")
            continue
        if rp != password("Confirmar root:"):
            warn("No coinciden")
            continue
        break

    users = []
    if confirm("¿Crear usuario adicional?"):
        while True:
            u = prompt("Nombre de usuario")
            if not USERNAME_RE.fullmatch(u):
                warn("Usa 1-32 caracteres: minúsculas, números, '_' o '-'")
                continue
            if u == "root":
                warn("'root' está reservado")
                continue
            pw = password(f"Contraseña para {u}:")
            if not pw or any(c in pw for c in ":\n\r"):
                warn("Contraseña obligatoria y sin ':' ni saltos de línea")
                continue
            if pw != password(f"Confirmar {u}:"):
                warn("No coinciden")
                continue
            users.append(UserConfig(username=u, password=pw))
            if not confirm("¿Otro usuario?", default=False):
                break
    return rp, users


def find_paths() -> tuple[str, str]:
    kernel_candidates = (
        os.path.join(PROJECT, "build", "kernel.bin"),
        os.path.join(PROJECT, "build", "iso", "boot", "kernel.bin"),
        os.path.join(PROJECT, "boot", "kernel.bin"),
    )
    k = next((path for path in kernel_candidates if os.path.isfile(path)), kernel_candidates[0])
    root_candidates = (
        os.path.join(PROJECT, "rootfs"),
        os.path.join(PROJECT, "installer", "rootfs"),
    )
    root = next((path for path in root_candidates if os.path.isdir(path)), root_candidates[0])
    return k, root


def ensure_kernel(ks: str) -> bool:
    if os.path.isfile(ks):
        return True
    warn(f"Kernel no encontrado en {ks}")
    if os.path.isfile(os.path.join(PROJECT, "Makefile")) and confirm("¿Compilar kernel ahora?"):
        try:
            subprocess.run(
                ["make", "-C", PROJECT, "PYTHON=python3", "iso"],
                check=True,
            )
            return os.path.isfile(ks) or os.path.isfile(os.path.join(PROJECT, "build", "kernel.bin"))
        except Exception as exc:
            error(str(exc))
    return False


def main() -> int:
    try:
        banner()
        if os.geteuid() != 0:
            error("Ejecutar como root: sudo tools/installer/nucleos-install")
            return 1

        info("Instalador de CortexOS v3")
        dim("Ctrl+C para cancelar\n")

        if not confirm("¿Iniciar instalación?"):
            return 0

        target_disk = pick_disk()
        if not target_disk:
            return 1

        scheme = pick_scheme()
        if scheme is None:
            return 1
        auto_part, uefi = scheme
        fstype = pick_fs()

        root_device = target_disk
        boot_device = ""
        if not auto_part:
            root_device = prompt("Dispositivo root (ej: /dev/sda2)")
            default_boot = "" if uefi else root_device
            boot_device = prompt(
                "Partición boot/EFI (ej: /dev/sda1)",
                default=default_boot or None,
            )
            if not root_device or not boot_device:
                error("Debes indicar las particiones root y boot/EFI")
                return 1
            if uefi and root_device == boot_device:
                error("En UEFI root y EFI deben ser particiones distintas")
                return 1

        hostname = ask_hostname()
        root_pw, users = ask_users()

        ks, rs = find_paths()
        if not ensure_kernel(ks):
            error("Compila primero: make iso")
            return 1

        p = PartitionConfig(
            device=root_device,
            fstype=fstype,
            boot_device=boot_device,
            disk_device=target_disk,
            uefi=uefi,
            auto_partition=auto_part,
        )
        cfg = CortexOSConfig(
            kernel_source=ks,
            rootfs_source=rs,
            hostname=hostname,
            root_password=root_pw,
            users=users or None,
            partition=p,
        )

        print()
        section("Resumen")
        for line in cfg.summary_lines():
            info(line)
        print()
        if not confirm("¿Proceder con la instalación?"):
            return 0
        if auto_part and not confirm("ADVERTENCIA: se borrarán todos los datos del disco. ¿Continuar?"):
            return 0

        ok("Instalando...")
        if install(cfg):
            section("Completado")
            ok("CortexOS instalado")
            if confirm("¿Reiniciar ahora?", default=False):
                subprocess.run(["reboot"], check=False)
            return 0

        section("Error")
        error("Falló la instalación; revisa el mensaje anterior")
        return 1

    except KeyboardInterrupt:
        print()
        info("Cancelado")
        return 130
    except Exception as exc:
        error(str(exc))
        return 1


if __name__ == "__main__":
    sys.exit(main())
